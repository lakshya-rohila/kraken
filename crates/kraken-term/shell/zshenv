# Kraken bootstrap: Kraken points ZDOTDIR here so it can load its shell
# integration. Put the user's ZDOTDIR back right away, then load their
# .zshenv as usual; .zprofile/.zshrc then load from their normal place.
if [[ -n "${KRAKEN_ORIG_ZDOTDIR+x}" ]]; then
  ZDOTDIR="$KRAKEN_ORIG_ZDOTDIR"
  unset KRAKEN_ORIG_ZDOTDIR
else
  unset ZDOTDIR
fi
typeset -g _kraken_integration="$KRAKEN_SHELL_INTEGRATION"
unset KRAKEN_SHELL_INTEGRATION
[[ -f "${ZDOTDIR:-$HOME}/.zshenv" ]] && source "${ZDOTDIR:-$HOME}/.zshenv"
[[ -o interactive && -r "$_kraken_integration" ]] && source "$_kraken_integration"
unset _kraken_integration
